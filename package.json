{
  "name": "ariangular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "ng serve",
    "build": "ng build && node scripts/generate-sitemap.js && node scripts/csp-hash.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "contrast": "node scripts/check-contrast.js",
    "verify": "npm run lint && npm run contrast && npm test && npm run build && npm run a11y",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\"",
    "fonte:fix": "node scripts/fix-aria.js fonte/ARIA.original.html fonte/ARIA.html",
    "fonte:validate": "node scripts/validate-html.js fonte/ARIA.html",
    "fonte:diff": "node scripts/diff-content.js fonte/ARIA.original.html fonte/ARIA.html",
    "content:extract": "node scripts/extract-content.js",
    "i18n:strings": "node scripts/extract-strings.js",
    "i18n:build": "node scripts/merge-i18n.js en && node scripts/build-locale.js en",
    "content:all": "npm run content:extract && npm run i18n:strings",
    "sitemap": "node scripts/generate-sitemap.js",
    "a11y": "node scripts/check-a11y.js",
    "a11y:sample": "node scripts/check-a11y.js --sample",
    "csp": "node scripts/csp-hash.js",
    "i18n:merge": "node scripts/merge-i18n.js en",
    "og": "node scripts/generate-og.js"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/aria": "^22.0.6",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  },
  "description": "Guia interativo de acessibilidade para times Angular — ARIA, WCAG 2.2, TalkBack e VoiceOver.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/negra1m/ariangular.git"
  },
  "homepage": "https://github.com/negra1m/ariangular",
  "author": "Vinicius Negrao",
  "keywords": [
    "angular",
    "accessibility",
    "a11y",
    "aria",
    "wcag",
    "talkback",
    "voiceover",
    "screen-reader"
  ]
}
