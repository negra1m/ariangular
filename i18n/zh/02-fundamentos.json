  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.title": "Angular 中最常见的错误",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.summary": "可点击的 div、没有标签的图标按钮、只有占位符的输入框、缺失的标题、不管理焦点的模态框，以及正数 tabindex。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.0": "用可点击的 div 冒充按钮。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.1": "可点击的图标没有 aria-label。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.2": "输入框只有占位符。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.3": "没有主标题。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.4": "模态框不管理焦点。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.5": "表单错误从来没有被朗读出来。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.6": "滥用 ARIA。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.7": "链接的行为像按钮。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.8": "按钮的行为像链接。",
  "sec.fundamentos.erros-mais-comuns-encontrados-em-angular.0.item.9": "使用正数 tabindex。",

  "sec.fundamentos.mentalidade-para-o-time-angular.title": "Angular 团队应有的思维方式",
  "sec.fundamentos.mentalidade-para-o-time-angular.summary": "在做任何组件之前先问五个问题——它们能在写下第一行代码之前就拦住大多数问题。",
  "sec.fundamentos.mentalidade-para-o-time-angular.0.cb.0.text": "在做任何组件之前，先问自己：",
  "sec.fundamentos.mentalidade-para-o-time-angular.0.cb.1.item.0": "有没有对应的原生 HTML 标签？",
  "sec.fundamentos.mentalidade-para-o-time-angular.0.cb.1.item.1": "这个元素有无障碍名称吗？",
  "sec.fundamentos.mentalidade-para-o-time-angular.0.cb.1.item.2": "它能用键盘操作吗？",
  "sec.fundamentos.mentalidade-para-o-time-angular.0.cb.1.item.3": "它在 TalkBack 下能用吗？",
  "sec.fundamentos.mentalidade-para-o-time-angular.0.cb.1.item.4": "它在 VoiceOver 下能用吗？"
}
