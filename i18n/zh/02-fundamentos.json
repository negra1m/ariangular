{
  "part.fundamentos.title": "Angular 无障碍基础",
  "part.fundamentos.summary": "基础知识：什么是无障碍、WCAG 2.2、POUR 四原则、屏幕阅读器如何朗读页面，以及 Angular 中最常见的错误。",

  "sec.fundamentos.o-que-e-acessibilidade.title": "什么是无障碍？",
  "sec.fundamentos.o-que-e-acessibilidade.summary": "无障碍是指数字产品能被任何人使用，无论其存在视觉、听觉、运动、认知还是暂时性的限制。",
  "sec.fundamentos.o-que-e-acessibilidade.0.text": "无障碍是数字产品能被每一个人使用的能力，无论其存在视觉、听觉、运动、认知还是暂时性的限制。",
  "sec.fundamentos.o-que-e-acessibilidade.1.cb.0.text": "用户示例：",
  "sec.fundamentos.o-que-e-acessibilidade.1.cb.1.item.0": "使用 TalkBack 的视障人士。",
  "sec.fundamentos.o-que-e-acessibilidade.1.cb.1.item.1": "使用 VoiceOver 的视障人士。",
  "sec.fundamentos.o-que-e-acessibilidade.1.cb.1.item.2": "使用缩放功能的低视力人士。",
  "sec.fundamentos.o-que-e-acessibilidade.1.cb.1.item.3": "使用键盘的行动不便人士。",
  "sec.fundamentos.o-que-e-acessibilidade.1.cb.1.item.4": "有认知障碍的人士。",
  "sec.fundamentos.o-que-e-acessibilidade.1.cb.1.item.5": "手臂受伤、只能单手操作的人。",

  "sec.fundamentos.wcag-2-2.title": "WCAG 2.2",
  "sec.fundamentos.wcag-2-2.summary": "WCAG 是全球评估数字无障碍最通用的标准。AA 是大多数企业追求的级别。",
  "sec.fundamentos.wcag-2-2.0.text": "WCAG（Web Content Accessibility Guidelines，网页内容无障碍指南）是全球评估数字无障碍最通用的一套准则。",
  "sec.fundamentos.wcag-2-2.1.text": "符合级别",
  "sec.fundamentos.wcag-2-2.2.h.0": "级别",
  "sec.fundamentos.wcag-2-2.2.h.1": "说明",
  "sec.fundamentos.wcag-2-2.2.r.0.0": "A",
  "sec.fundamentos.wcag-2-2.2.r.0.1": "最低要求。",
  "sec.fundamentos.wcag-2-2.2.r.1.0": "AA",
  "sec.fundamentos.wcag-2-2.2.r.1.1": "大多数企业采用的级别。",
  "sec.fundamentos.wcag-2-2.2.r.2.0": "AAA",
  "sec.fundamentos.wcag-2-2.2.r.2.1": "最严格的级别。",

  "sec.fundamentos.pour.title": "POUR 四原则",
  "sec.fundamentos.pour.summary": "每一条 WCAG 准则都源自四大支柱：可感知、可操作、可理解、健壮性。",
  "sec.fundamentos.pour.0.text": "每一条 WCAG 准则都源自四大支柱：",
  "sec.fundamentos.pour.1.text": "P — 可感知",
  "sec.fundamentos.pour.2.item.0": "用户必须能够感知内容。",
  "sec.fundamentos.pour.2.item.1": "图片需要替代文本。",
  "sec.fundamentos.pour.2.item.2": "信息不能只靠颜色传达。",
  "sec.fundamentos.pour.3.text": "O — 可操作",
  "sec.fundamentos.pour.4.item.0": "界面必须是可操作的。",
  "sec.fundamentos.pour.4.item.1": "能用键盘操作。",
  "sec.fundamentos.pour.4.item.2": "能配合屏幕阅读器使用。",
  "sec.fundamentos.pour.5.text": "U — 可理解",
  "sec.fundamentos.pour.6.item.0": "流程保持一致。",
  "sec.fundamentos.pour.6.item.1": "信息表达清晰。",
  "sec.fundamentos.pour.6.item.2": "错误容易理解。",
  "sec.fundamentos.pour.7.text": "R — 健壮性",
  "sec.fundamentos.pour.8.item.0": "能与辅助技术协同工作。",
  "sec.fundamentos.pour.8.item.1": "语义化 HTML。",
  "sec.fundamentos.pour.8.item.2": "正确的 ARIA。",

  "sec.fundamentos.leitores-de-tela-2.title": "屏幕阅读器",
  "sec.fundamentos.leitores-de-tela-2.summary": "Android 上是 TalkBack，iOS 上是 VoiceOver。两者都需要三样东西：无障碍名称、正确的角色、正确的状态。",
  "sec.fundamentos.leitores-de-tela-2.0.text": "TalkBack",
  "sec.fundamentos.leitores-de-tela-2.1.text": "Android 的原生屏幕阅读器。",
  "sec.fundamentos.leitores-de-tela-2.2.text": "VoiceOver",
  "sec.fundamentos.leitores-de-tela-2.3.text": "iOS 的原生屏幕阅读器。",
  "sec.fundamentos.leitores-de-tela-2.4.text": "它们需要什么才能正常工作？",
  "sec.fundamentos.leitores-de-tela-2.5.item.0": "无障碍名称。",
  "sec.fundamentos.leitores-de-tela-2.5.item.1": "正确的角色。",
  "sec.fundamentos.leitores-de-tela-2.5.item.2": "正确的状态。",
  "sec.fundamentos.leitores-de-tela-2.6.text": "示例",
  "sec.fundamentos.leitores-de-tela-2.7.str.0": "保存",
  "sec.fundamentos.leitores-de-tela-2.8.text": "保存，按钮",

  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.title": "屏幕阅读器是怎么“看”页面的？",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.summary": "和视力正常的人完全不同。它按标题、按钮、链接、字段和地标来遍历——一个视觉上完美的页面可能完全无法使用。",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.0.text": "这些用户看界面的方式和视力正常的人完全不同。",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.1.text": "他们通过以下方式导航：",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.2.item.0": "标题。",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.2.item.1": "按钮。",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.2.item.2": "链接。",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.2.item.3": "字段。",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.2.item.4": "地标。",
  "sec.fundamentos.como-um-leitor-de-tela-enxerga-uma-pagina.3.cb.0.text": "一个视觉上完美的页面，用屏幕阅读器可能完全无法使用。",

  "sec.fundamentos.regra-de-ouro-da-acessibilidade.title": "无障碍的黄金法则",
  "sec.fundamentos.regra-de-ouro-da-acessibilidade.summary": "先语义化 HTML，再考虑 ARIA。如果原生标签能解决问题，就用它——角色、键盘和状态都是免费附带的。",
  "sec.fundamentos.regra-de-ouro-da-acessibilidade.0.text": "HTML 优先",
  "sec.fundamentos.regra-de-ouro-da-acessibilidade.1.text": "在动用 ARIA 之前，永远优先使用语义化 HTML。",
  "sec.fundamentos.regra-de-ouro-da-acessibilidade.2.str.0": "保存",
  "sec.fundamentos.regra-de-ouro-da-acessibilidade.3.str.0": "保存",
  "sec.fundamentos.regra-de-ouro-da-acessibilidade.4.cb.0.text": "如果原生 HTML 标签能解决问题，就用它。",

  "sec.fundamentos.estrutura-semantica-basica.title": "基本语义结构",
  "sec.fundamentos.estrutura-semantica-basica.summary": "header、nav、main 和 footer 在第一行内容被读出之前，就把页面的地图交给了屏幕阅读器。",
  "sec.fundamentos.estrutura-semantica-basica.0.str.0": "页头",
  "sec.fundamentos.estrutura-semantica-basica.0.str.1": "导航",
  "sec.fundamentos.estrutura-semantica-basica.0.str.2": "主标题",
  "sec.fundamentos.estrutura-semantica-basica.0.str.3": "页脚",

  "sec.fundamentos.landmarks.title": "地标",
  "sec.fundamentos.landmarks.summary": "地标让屏幕阅读器可以直接跳到页面的重要区域，而不必把所有内容都听一遍。",
  "sec.fundamentos.landmarks.0.text": "地标让屏幕阅读器能够在页面的重要区域之间快速导航。",
  "sec.fundamentos.landmarks.1.h.0": "标签",
  "sec.fundamentos.landmarks.1.h.1": "用途",
  "sec.fundamentos.landmarks.1.r.0.0": "header",
  "sec.fundamentos.landmarks.1.r.0.1": "页头。",
  "sec.fundamentos.landmarks.1.r.1.0": "nav",
  "sec.fundamentos.landmarks.1.r.1.1": "导航。",
  "sec.fundamentos.landmarks.1.r.2.0": "main",
  "sec.fundamentos.landmarks.1.r.2.1": "主要内容。",
  "sec.fundamentos.landmarks.1.r.3.0": "aside",
  "sec.fundamentos.landmarks.1.r.3.1": "补充内容。",
  "sec.fundamentos.landmarks.1.r.4.0": "footer",
  "sec.fundamentos.landmarks.1.r.4.1": "页脚。",

  "sec.fundamentos.headings.title": "标题层级",
  "sec.fundamentos.headings.summary": "标题构成一棵导航树。跳级会暗示一个并不存在的结构，让人迷失方向。",
  "sec.fundamentos.headings.0.text": "标题构成一棵导航树。",
  "sec.fundamentos.headings.1.str.0": "活期账户",
  "sec.fundamentos.headings.1.str.1": "余额",
  "sec.fundamentos.headings.1.str.2": "对账单",
  "sec.fundamentos.headings.1.str.3": "最新记录",
  "sec.fundamentos.headings.2.str.0": "活期账户",
  "sec.fundamentos.headings.2.str.1": "对账单",

  "sec.fundamentos.accessible-name.title": "无障碍名称",
  "sec.fundamentos.accessible-name.summary": "每个可交互元素都需要名称。它来自可见文本，或者在没有文本可用时来自 aria-label。",
  "sec.fundamentos.accessible-name.0.text": "每个可交互元素都必须有无障碍名称。",
  "sec.fundamentos.accessible-name.1.text": "可见文本",
  "sec.fundamentos.accessible-name.2.str.0": "继续",
  "sec.fundamentos.accessible-name.3.text": "继续，按钮",
  "sec.fundamentos.accessible-name.4.text": "aria-label",
  "sec.fundamentos.accessible-name.5.str.0": "关闭模态框",
  "sec.fundamentos.accessible-name.5.str.1": "关闭",
  "sec.fundamentos.accessible-name.6.text": "关闭模态框，按钮",

  "sec.fundamentos.accessible-description.title": "无障碍描述",
  "sec.fundamentos.accessible-description.summary": "aria-describedby 在名称之外补充一段提示。屏幕阅读器会先读字段名称，再读描述。",
  "sec.fundamentos.accessible-description.0.str.0": "仅限数字",
  "sec.fundamentos.accessible-description.1.text": "屏幕阅读器会把字段名称和它的描述合在一起朗读。",

  "sec.fundamentos.nome-role-estado.title": "名称 + 角色 + 状态",
  "sec.fundamentos.nome-role-estado.summary": "几乎所有屏幕阅读器问题都可以归结为三个问题：名称是什么、角色是什么、状态是什么。",
  "sec.fundamentos.nome-role-estado.0.text": "几乎任何屏幕阅读器分析都可以归结为三个问题：",
  "sec.fundamentos.nome-role-estado.1.h.0": "问题",
  "sec.fundamentos.nome-role-estado.1.h.1": "示例",
  "sec.fundamentos.nome-role-estado.1.r.0.0": "名称是什么？",
  "sec.fundamentos.nome-role-estado.1.r.0.1": "保存",
  "sec.fundamentos.nome-role-estado.1.r.1.0": "角色是什么？",
  "sec.fundamentos.nome-role-estado.1.r.1.1": "按钮",
